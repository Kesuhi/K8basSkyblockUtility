{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NPC list (REQ-NPCDB-06, T3.8): fixed NPCs with their block, moving ones with the name text to match",
  "x-keys": {
    "/rows": "id"
  },
  "type": "object",
  "required": [
    "rows"
  ],
  "properties": {
    "table": {
      "const": "npcdb.npcs"
    },
    "schemaVersion": {
      "const": 1
    },
    "license": {
      "const": "MIT"
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "displayName",
          "island",
          "fixed"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60,
            "pattern": "^\\S(.*\\S)?$"
          },
          "island": {
            "enum": [
              "Private Island",
              "Hub",
              "Garden",
              "The Farming Islands",
              "The Park",
              "Moonglade Marsh",
              "Torrhus Canyon",
              "Spider's Den",
              "The End",
              "Crimson Isle",
              "Gold Mine",
              "Deep Caverns",
              "Dwarven Mines",
              "Crystal Hollows",
              "Glacite Mineshafts",
              "Backwater Bayou",
              "Lotus Atoll",
              "Critter Safari",
              "Kuudra",
              "Jerry",
              "The Rift",
              "Dark Auction",
              "Catacombs",
              "Dungeon Hub"
            ]
          },
          "fixed": {
            "type": "boolean"
          },
          "x": {
            "type": "integer"
          },
          "y": {
            "type": "integer",
            "minimum": -64,
            "exclusiveMaximum": 320
          },
          "z": {
            "type": "integer"
          },
          "matchText": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60,
            "pattern": "^\\S(.*\\S)?$"
          },
          "aliases": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9_]+$"
            }
          }
        },
        "if": {
          "properties": {
            "fixed": {
              "const": true
            }
          }
        },
        "then": {
          "required": [
            "x",
            "y",
            "z"
          ],
          "not": {
            "required": [
              "matchText"
            ]
          }
        },
        "else": {
          "required": [
            "matchText"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "x"
                ]
              },
              {
                "required": [
                  "y"
                ]
              },
              {
                "required": [
                  "z"
                ]
              }
            ]
          }
        }
      }
    }
  }
}
