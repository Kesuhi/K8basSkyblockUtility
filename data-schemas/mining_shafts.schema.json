{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Glacite Mineshaft codes and display names (REQ-GS-17, T3.0m)",
  "x-keys": {"/rows": "code"},
  "type": "object",
  "required": ["rows"],
  "properties": {
    "table": {"const": "mining_shafts"},
    "schemaVersion": {"const": 1},
    "license": {"const": "CC0-1.0"},
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["code", "name"],
        "additionalProperties": false,
        "properties": {
          "code": {"type": "string", "pattern": "^[A-Z]{4}_[12CL]$"},
          "name": {"type": "string", "minLength": 1, "maxLength": 40}
        }
      }
    }
  }
}
