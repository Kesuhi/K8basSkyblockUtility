{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Possible frozen-corpse spots per Glacite Mineshaft code (T3.3a, REQ-CORPSE-01, REQ-CORPSE-10, R40), merged from SkyHanni-REPO PR #759, meowdding-repo and ShaftUtils",
  "x-keys": {"/rows": "code"},
  "type": "object",
  "required": ["rows", "noData", "mergeRadius"],
  "properties": {
    "table": {"const": "mining.corpse_spots"},
    "schemaVersion": {"const": 1},
    "license": {"const": "MIT"},
    "mergeRadius": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Points of one code within this many blocks were merged into one spot."
    },
    "noData": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z]{4}_[12CL]$"},
      "description": "Known codes no source has spots for."
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["code", "spots"],
        "additionalProperties": false,
        "properties": {
          "code": {"type": "string", "pattern": "^[A-Z]{4}_[12CL]$"},
          "spots": {
            "type": "array",
            "minItems": 1,
            "description": "In a stable order: a spot's 1-based place here is its number in game.",
            "items": {
              "type": "object",
              "required": ["x", "y", "z", "sourceRefs"],
              "additionalProperties": false,
              "properties": {
                "x": {"type": "integer", "minimum": -260, "maximum": -40},
                "y": {"type": "integer", "minimum": -10, "maximum": 80},
                "z": {"type": "integer", "minimum": -260, "maximum": -90},
                "sourceRefs": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {"type": "string"},
                  "description": "Keys of this table's sources that list the spot."
                }
              }
            }
          }
        }
      }
    },
    "$schema": {},
    "dataVersion": {},
    "gameVersion": {},
    "generatedAt": {},
    "sources": {}
  },
  "additionalProperties": false
}
