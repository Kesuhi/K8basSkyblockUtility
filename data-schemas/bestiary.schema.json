{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bestiary families with their kill brackets (T5.1, REQ-BEST-15, D-5): the trimmed NEU-REPO constants/bestiary.json",
  "x-keys": {"/rows": "id"},
  "type": "object",
  "required": ["brackets", "categories", "rows"],
  "properties": {
    "table": {"const": "bestiary"},
    "schemaVersion": {"const": 1},
    "license": {"const": "MIT"},
    "brackets": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z0-9_]+$"},
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {"type": "integer", "minimum": 1}
      },
      "description": "Cumulative kill thresholds by bracket id: NEU's brackets by number, its bracket sets as <set>_<number> (critters_1)."
    },
    "categories": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z0-9_]+$"},
      "additionalProperties": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "subcategories": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {"pattern": "^[a-z0-9_]+$"},
            "additionalProperties": {
              "type": "object",
              "required": ["name"],
              "additionalProperties": false,
              "properties": {"name": {"type": "string", "minLength": 1}}
            }
          }
        }
      },
      "description": "NEU's category keys with the names the Bestiary menu shows (Bestiary ➜ <name>, Fishing ➜ <subcategory name>)."
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "category", "bracket", "cap", "maxTiers", "mobs"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$", "description": "Stable slug; the sbxp tables refer to it as bestiary:<id>. Built from the name in lower case, apostrophes dropped and other runs of non-letters and non-digits as _; a name two categories share gets _<subcategory or category> on each (bat_dynamic, bat_catacombs). A shipped id never changes: when a new pin adds a family whose name is taken, only the new family gets the suffix."},
          "name": {"type": "string", "minLength": 1},
          "category": {"type": "string"},
          "subcategory": {"type": "string"},
          "bracket": {"type": "string"},
          "cap": {"type": "integer", "minimum": 1},
          "maxTiers": {"type": "integer", "minimum": 1, "description": "The bracket's thresholds below the cap, plus the cap as the last tier."},
          "mobs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}
          }
        }
      }
    },
    "$schema": {},
    "dataVersion": {},
    "gameVersion": {},
    "generatedAt": {},
    "sources": {}
  },
  "additionalProperties": false
}
