{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RNG meter scores (T3.9g, REQ-ODDS-09, D-5): the dungeon score per floor (catacombs) and the slayer XP per boss (slayer) an RNG meter needs for each item, from NEU constants/rngscore.json (MIT)",
  "x-keys": {
    "/rows": "id"
  },
  "type": "object",
  "required": [
    "rows"
  ],
  "properties": {
    "table": {
      "const": "odds.rngscore"
    },
    "schemaVersion": {
      "const": 1
    },
    "license": {
      "const": "MIT"
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "item",
          "displayName",
          "sourceRefs",
          "license",
          "verified",
          "gameVersion",
          "case",
          "group",
          "score"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_:;.\\- ]+$"
          },
          "item": {
            "type": "string",
            "pattern": "^[A-Z0-9_;]+$",
            "description": "The SkyBlock item id (NEU internal id; enchanted books NAME;LEVEL)."
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60,
            "pattern": "^\\S(.*\\S)?$",
            "description": "The name as shown in game, for matching."
          },
          "sourceRefs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            },
            "description": "Keys of this table's sources."
          },
          "license": {
            "enum": [
              "CC0-1.0",
              "MIT"
            ]
          },
          "verified": {
            "type": "boolean",
            "description": "False for a wiki-only number (shown with \"?\", REQ-ODDS-06/10)."
          },
          "gameVersion": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+(\\.\\d+)?$",
            "description": "The SkyBlock version the row was last checked against."
          },
          "case": {
            "enum": [
              "catacombs",
              "slayer"
            ]
          },
          "group": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "description": "The floor (F1..F7, M1..M7) or the slayer boss as NEU names it."
          },
          "score": {
            "type": "integer",
            "minimum": 1,
            "description": "Dungeon score (catacombs) or slayer XP (slayer) the meter needs."
          },
          "placeholder": {
            "type": "boolean",
            "description": "A value that looks like a stand-in (a round dye score); excluded from rank lines (REQ-ODDS-17)."
          }
        }
      }
    },
    "$schema": {},
    "dataVersion": {},
    "gameVersion": {},
    "generatedAt": {},
    "sources": {}
  },
  "additionalProperties": false
}
